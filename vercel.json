{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "deployment/vercel",
  "redirects": [
    {
      "source": "/",
      "destination": "https://portal-del-edificio.meme-scanner-nicolas.workers.dev/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://portal-del-edificio.meme-scanner-nicolas.workers.dev/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
